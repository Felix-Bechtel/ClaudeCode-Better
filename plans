#!/bin/bash
# plans — select the Claude plan badge shown in the statusline footer.
# PURELY AESTHETIC: it only changes the plan name displayed in the footer.
# It does NOT touch the token budget, percentages, or anything else.
# Run as `! plans` inside Claude Code, or `plans` in a regular terminal.
#
# Usage:
#   plans               Show the menu (interactive in a TTY)
#   plans 1|pro         Pro
#   plans 2|5x|max5x    Max 5x
#   plans 3|20x|max20x  Max 20x
#   plans 4|team        Team
#   plans 5|ent         Enterprise
#   plans "Anything"    Custom badge text

GREEN='\033[32m'
YEL='\033[33m'
DIM='\033[2m'
BOLD='\033[1m'
CYAN='\033[36m'
MAG='\033[35m'
BL='\033[34m'
R='\033[0m'

SETTINGS="$HOME/.claude/settings.json"
[ ! -e "$SETTINGS" ] && SETTINGS="$HOME/Claude/Claude Code Settings/settings.json"

if [ ! -e "$SETTINGS" ] || ! command -v jq >/dev/null 2>&1; then
  printf "${YEL}Cannot set plan.${R} ${DIM}(settings file or jq missing)${R}\n"
  exit 1
fi

# ~/.claude/settings.json may be a symlink — write through to the real
# file so we don't replace the link with a plain copy.
REAL=$(readlink -f "$SETTINGS" 2>/dev/null || echo "$SETTINGS")

apply() {
  local name="$1" tmp="$REAL.tmp.$$"
  jq --arg n "$name" '. + {statusLinePlanName: $n}' "$REAL" > "$tmp" && mv "$tmp" "$REAL"
  printf "\n  ${GREEN}✓${R} Footer badge set to ${BL}${BOLD}%s${R}\n" "$name"
  printf "  ${DIM}Aesthetic only — budget and usage numbers are untouched.${R}\n"
  printf "  ${DIM}Footer updates on the next status tick (~1s).${R}\n\n"
  # Bust the usage cache so the footer reflects the change immediately.
  rm -f "${TMPDIR:-/tmp}/token-tracker-usage.json" 2>/dev/null
}

menu() {
  CURRENT=$(jq -r '.statusLinePlanName // empty' "$REAL" 2>/dev/null)
  printf "\n"
  printf "${MAG}${BOLD}╔══════════════════════════════════════════════════╗${R}\n"
  printf "${MAG}${BOLD}║${R}   ${YEL}${BOLD}!  P L A N S${R}  ${DIM}— pick your plan, flex the footer${R}   ${MAG}${BOLD}║${R}\n"
  printf "${MAG}${BOLD}╚══════════════════════════════════════════════════╝${R}\n"
  [ -n "$CURRENT" ] && printf "  ${DIM}current badge:${R} ${BL}${BOLD}%s${R}\n" "$CURRENT"
  printf "\n"
  printf "  ${GREEN}1${R}  Pro\n"
  printf "  ${GREEN}2${R}  Max 5x\n"
  printf "  ${GREEN}3${R}  Max 20x\n"
  printf "  ${GREEN}4${R}  Team\n"
  printf "  ${GREEN}5${R}  Enterprise\n"
  printf "\n"
  printf "  ${DIM}Aesthetic only — changes the footer badge, nothing else.${R}\n"
}

set_choice() {
  case "$(echo "$1" | tr '[:upper:]' '[:lower:]')" in
    1|pro)                apply "Pro" ;;
    2|5x|max5x|max-5x)    apply "Max 5x" ;;
    3|20x|max20x|max-20x) apply "Max 20x" ;;
    4|team)               apply "Team" ;;
    5|ent|enterprise)     apply "Enterprise" ;;
    *)                    apply "$1" ;;   # custom badge text
  esac
}

if [ -n "$1" ]; then
  set_choice "$1"
elif [ -t 0 ]; then
  menu
  printf "  ${BOLD}Pick a plan [1-5]:${R} "
  read -r choice
  [ -n "$choice" ] && set_choice "$choice" || printf "  ${DIM}no change${R}\n"
else
  menu
  printf "  ${DIM}Not a TTY — run with a choice, e.g.:${R}  ${BOLD}${GREEN}! plans 3${R}\n\n"
fi
